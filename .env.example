# Telegram (get from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_GROUP_ID=        # e.g. -1001234567890
TELEGRAM_SELF_ID=         # your own Telegram user ID

# Gemini (get from https://aistudio.google.com)
GEMINI_API_KEY=

# Gmail (use App Password, not your real password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Google Drive (base64-encoded service account JSON)
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_DRIVE_FOLDER_ID=

# Job Crawler platforms
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# Crawler settings
ENABLE_CRAWLER=true
CRAWL_INTERVAL_SECONDS=3600        # how often non-LinkedIn scrapers run (default: 1 hour)
LINKEDIN_INTERVAL_SECONDS=86400    # how often LinkedIn runs (default: once per day)

# App
LOG_LEVEL=INFO
MOCK_GEMINI=false

# Resume (optional): path to your LaTeX resume. Defaults to templates/resume.tex,
# then falls back to templates/resume.example.tex
RESUME_TEMPLATE=

# Dashboard API (optional)
API_PORT=8765
DASHBOARD_URL=http://localhost:3000
# launchd label of the bot, so the dashboard's Start/Pause button can control it (macOS)
BOT_LAUNCHD_LABEL=com.pursuit.bot
